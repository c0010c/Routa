{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "routa",
  "version": "0.2.0",
  "identifier": "dev.routa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-procsvc.mjs && node scripts/build-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Routa",
        "width": 1200,
        "height": 800
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/mihomo", "binaries/routa-procsvc"],
    "resources": { "binaries/procsvc/*": "procsvc/" },
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "nsis/hooks.nsh" }
    }
  }
}
